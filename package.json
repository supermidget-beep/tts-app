{
  "name": "wuxia-tts-reader",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
